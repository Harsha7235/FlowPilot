options:
  parameters:
    author: ''
    category: FlowPilot
    description: Generated starter signal viewer
    generate_options: qt_gui
    id: flowpilot_signal_viewer
    max_nouts: '0'
    output_language: python
    placement: (0, 0)
    qt_qss_theme: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: resize
    title: FlowPilot generated flowgraph
  states:
    bus_sink: false
    bus_source: false
    coordinate:
    - 10
    - 10
    rotation: 0
    state: enabled
