    comment: ''
    value: "[0., 0., 0., 0., 0., 0., 0., 1.41421356, 0., -1.41421356, 0., 1.41421356,\n\
      \      0., -1.41421356, 0., -1.41421356, 0., -1.41421356, 0., 1.41421356, 0.,\
      \ -1.41421356,\n      0., 1.41421356, 0., -1.41421356, 0., -1.41421356, 0.,\
      \ -1.41421356, 0., -1.41421356,\n      0., 1.41421356, 0., -1.41421356, 0.,\
      \ 1.41421356, 0., 1.41421356, 0., 1.41421356,\n      0., -1.41421356, 0., 1.41421356,\
      \ 0., 1.41421356, 0., 1.41421356, 0., -1.41421356,\n      0., 1.41421356, 0.,\
      \ 1.41421356, 0., 1.41421356, 0., 0., 0., 0., 0., 0.]"
