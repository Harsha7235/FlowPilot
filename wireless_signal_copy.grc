    value: "[0j, 0j, 0j, 0j, 0j, 0j, (-1+0j), (-1+0j), (-1+0j), (-1+0j), (1+0j), (1+0j),\n\
      \      (-1+0j), (-1+0j), (-1+0j), (1+0j), (-1+0j), (1+0j), (1+0j), (1 +0j),\
      \ (1+0j),\n      (1+0j), (-1+0j), (-1+0j), (-1+0j), (-1+0j), (-1+0j), (1+0j),\
      \ (-1+0j), (-1+0j),\n      (1+0j), (-1+0j), 0j, (1+0j), (-1+0j), (1+0j), (1+0j),\
      \ (1+0j), (-1+0j), (1+0j),\n      (1+0j), (1+0j), (-1+0j), (1+0j), (1+0j), (1+0j),\
      \ (1+0j), (-1+0j), (1+0j), (-1+0j),\n      (-1+0j), (-1+0j), (1+0j), (-1+0j),\
      \ (1+0j), (-1+0j), (-1+0j), (-1+0j), (-1+0j),\n      0j, 0j, 0j, 0j, 0j]"
