    {
      "id": "label",
      "label": "Label",
      "dtype": "string",
      "default": null,
      "options": [],
      "extra": {
        "hide": "${ ('none' if label else 'part') }"
      }
    },
    {
      "id": "type",
      "label": "Type",
      "dtype": "enum",
      "default": "int",
      "options": [
        "real",
