    "templates": {
      "var_make": "self.${id} = None",
      "make": "<%\n    win = '_%s_toggle_button'%id\n%>\\\n${win} = qtgui.MsgPushButton(${(label if (len(label) - 2 > 0) else repr(id))}, ${msgName},${value},\"${relBackgroundColor}\",\"${relFontColor}\")\nself.${id} = ${win}\n\n${gui_hint() % win}",
      "callbacks": [
        "set_new_msg(${value})"
      ]
    },
