      "make": "% if type == \"complex\":\nthis->${id} = fft::fft_v<gr_complex, ${forward}>::make(${fft_size}, ${window}, ${shift}, ${nthreads});\n% else:\nthis->${id} = fft::fft_v<float, ${forward}>::make(${fft_size}, ${window}, ${shift}, ${nthreads});\n% endif",
