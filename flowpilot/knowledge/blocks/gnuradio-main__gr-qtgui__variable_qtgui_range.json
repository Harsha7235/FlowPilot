{
  "block_id": "variable_qtgui_range",
  "name": "QT GUI Range",
  "label": "QT GUI Range",
  "category": null,
  "description": null,
  "documentation": "This block creates a variable with a slider.     Leave the label blank to use the variable id as the label.     The value must be a real number.     The value must be between the start and the stop.\n\n    The GUI hint can be used to position the widget within the application.     The hint is of the form [tab_id@tab_index]: [row, col, row_span, col_span].     Both the tab specification and the grid position are optional.",
  "parameters": [
    {
      "id": "label",
      "label": "Label",
      "dtype": "string",
      "default": null,
      "options": [],
      "extra": {
        "hide": "${ ('none' if label else 'part') }"
      }
    },
    {
      "id": "rangeType",
      "label": "Type",
      "dtype": "enum",
      "default": "\"float\"",
      "options": [
        "float",
        "int"
      ],
      "extra": {
        "option_attributes": {
          "type": [
            "float",
            "int"
          ]
        },
        "hide": "part"
      }
    },
    {
      "id": "value",
      "label": "Default Value",
      "dtype": "${ rangeType.type }",
      "default": "50",
      "options": [],
      "extra": {}
    },
    {
      "id": "start",
      "label": "Start",
      "dtype": "${ rangeType.type }",
      "default": "0",
      "options": [],
      "extra": {}
    },
    {
      "id": "stop",
      "label": "Stop",
      "dtype": "${ rangeType.type }",
      "default": "100",
      "options": [],
      "extra": {}
    },
    {
      "id": "step",
      "label": "Step",
      "dtype": "${ rangeType.type }",
      "default": "1",
      "options": [],
      "extra": {}
    },
    {
      "id": "widget",
      "label": "Widget",
      "dtype": "enum",
      "default": "counter_slider",
      "options": [
        "counter_slider",
        "counter",
        "slider",
        "dial",
        "eng_slider",
        "eng"
      ],
      "extra": {
        "option_labels": [
          "Counter + Slider",
          "Counter",
          "Slider",
          "Knob",
          "Entry + Slider",
          "Entry"
        ],
        "hide": "part"
      }
    },
    {
      "id": "orient",
      "label": "Orientation",
      "dtype": "enum",
      "default": "QtCore.Qt.Horizontal",
      "options": [
        "QtCore.Qt.Horizontal",
        "QtCore.Qt.Vertical"
      ],
      "extra": {
        "option_labels": [
          "Horizontal",
          "Vertical"
        ],
        "option_attributes": {
          "minfcn": [
            "setMinimumWidth",
            "setMinimumHeight"
          ],
          "scalepos": [
            "BottomScale",
            "LeftScale"
          ]
        },
        "hide": "${ ('part' if widget == \"slider\" else 'all') }"
      }
    },
    {
      "id": "min_len",
      "label": "Minimum Length",
      "dtype": "int",
      "default": "200",
      "options": [],
      "extra": {
        "hide": "part"
      }
    },
    {
      "id": "gui_hint",
      "label": "GUI Hint",
      "dtype": "gui_hint",
      "default": null,
      "options": [],
