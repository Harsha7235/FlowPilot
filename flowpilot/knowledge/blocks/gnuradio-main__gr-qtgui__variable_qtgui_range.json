    ],
    "value": "${ value }",
    "asserts": [
      "${start <= value <= stop}",
      "${start <= stop}"
    ],
    "templates": {
      "imports": "from PyQt5 import QtCore",
      "var_make": "self.${id} = ${id} = ${value}",
      "callbacks": [
        "self.set_${id}(${value})"
      ],
      "make": "<%\n    win = 'self._%s_win'%id\n    range = 'self._%s_range'%id\n%>\\\n${range} = qtgui.Range(${start}, ${stop}, ${step}, ${value}, ${min_len})\n${win} = qtgui.RangeWidget(${range}, self.set_${id}, \"${no_quotes(label,repr(id))}\", \"${widget}\", ${rangeType}, ${orient})\n${gui_hint() % win}"
    },
