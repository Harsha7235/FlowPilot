{
  "block_id": "variable_qtgui_dial_control",
  "name": "QT GUI Dial",
  "label": "QT GUI Dial",
  "category": "[Core]/GUI Widgets/QT",
  "description": null,
  "documentation": "This block creates a dial control. The control does control a variable which can be used for other items.  Leave the label blank to use the variable id as the label.\n\nThe block also creates an optional message with the control value that can be used in message-based applications.\n\nNote: Dials only produce integer values, so the scale factor can be used with the min/max to adjust the output value to the desired range.  Think of the min/max as the increments, and the scale factor as the adjustment to get the values you want.\n\nThe GUI hint can be used to position the widget within the application. The hint is of the form [tab_id@tab_index]: [row, col, row_span, col_span]. Both the tab specification and the grid position are optional.",
  "parameters": [
    {
      "id": "label",
      "label": "Label",
      "dtype": "string",
      "default": null,
      "options": [],
      "extra": {
        "hide": "${ ('none' if label else 'part') }"
      }
    },
    {
      "id": "type",
      "label": "Type",
      "dtype": "enum",
      "default": "int",
      "options": [
        "real",
        "int"
      ],
      "extra": {
        "option_labels": [
          "Float",
          "Integer"
        ],
        "option_attributes": {
          "conv": [
            "float",
            "int"
          ]
        },
        "hide": "part"
      }
    },
    {
      "id": "value",
      "label": "Default Value",
      "dtype": "${ type }",
      "default": "0",
      "options": [],
      "extra": {}
    },
    {
      "id": "minimum",
      "label": "Minimum",
      "dtype": "${ type }",
      "default": "0",
      "options": [],
      "extra": {}
    },
    {
      "id": "maximum",
