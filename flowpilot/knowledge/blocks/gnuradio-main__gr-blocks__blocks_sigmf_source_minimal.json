      "default": null,
      "options": [],
      "extra": {}
    },
    {
      "id": "type",
      "label": "Output Type",
      "dtype": "enum",
      "default": null,
      "options": [
        "complex float (fc32_le)",
        "real float (rc32_le)",
        "complex short (sc16_le)",
        "real short (rc16_le)"
      ],
      "extra": {
        "option_labels": [
          "complex float (cf32_le)",
