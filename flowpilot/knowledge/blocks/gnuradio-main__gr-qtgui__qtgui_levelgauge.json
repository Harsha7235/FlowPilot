    "templates": {
      "make": "<%\n    win = '_%s_lg_win'%id\n%>\\\n\nif \"${type}\" == \"int\":\n\tisFloat = False\n\tscaleFactor = 1\nelse:\n\tisFloat = True\n\tscaleFactor = ${scaleFactor}\n\t\n${win} = qtgui.GrLevelGauge(${label},\"${barColor}\",\"${backgroundColor}\",\"${fontColor}\",${minimum},${maximum}, ${msize}, ${isVertical},${position},isFloat,scaleFactor,${showValue},self)\n${win}.setValue(${value})\nself.${id} = ${win}\n\n${gui_hint() % win}",
      "callbacks": [
        "self.${id}.setValue(${value})"
      ]
    },
