        "dtype": "int",
        "default": -1,
        "hide": "${ 'part' if device_select == -1 else 'none'}"
      },
      {
        "id": "instance_index",
        "label": "Instance Select",
        "dtype": "int",
        "default": -1,
        "hide": "${ 'part' if instance_index == -1 else 'none'}"
      },
      {
        "id": "sum_len",
        "label": "Sum Length",
        "dtype": "int",
        "default": 10
      },
      {
        "id": "divisor",
        "label": "Divisor",
        "dtype": "int",
        "default": 10
      }
    ],
    "inputs": [
      {
        "domain": "rfnoc",
        "dtype": "sc16"
      }
    ],
    "outputs": [
      {
        "domain": "rfnoc",
        "dtype": "sc16"
      }
    ],
    "asserts": [
      "${1 <= sum_len <= 255}",
      "${1 <= divisor <= 2**24-1}"
    ],
