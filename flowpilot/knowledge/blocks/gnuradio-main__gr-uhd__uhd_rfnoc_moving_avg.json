    "templates": {
      "imports": "from gnuradio import uhd",
      "make": "uhd.rfnoc_block_generic(\n    self.rfnoc_graph,\n    uhd.device_addr(${block_args}),\n    \"MovingAverage\",\n    ${device_select},\n    ${instance_index})\nself.${id}.set_property('sum_len', ${sum_len})\nself.${id}.set_property('divisor', ${divisor})",
      "callbacks": [
        "set_property('sum_len', ${sum_len})",
        "set_property('divisor', ${divisor})"
      ]
    },
    "parameters": [
