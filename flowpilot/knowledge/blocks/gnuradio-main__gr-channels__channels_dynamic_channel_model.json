      "make": "channels.dynamic_channel_model(\n    ${samp_rate}, \n    ${sro_stdev}, \n    ${sro_maxdev},\n    ${cfo_stdev}, \n    ${cfo_maxdev}, \n    ${N}, \n    ${fD}, \n    ${LOS}, \n    ${K}, \n    ${delays}, \n    ${mags},\n    ${ntaps}, \n    ${noise_amp}, \n    ${seed})",
      "callbacks": [
