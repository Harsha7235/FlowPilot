    ],
    "parameters": [
      {
        "id": "label",
        "label": "Label",
        "dtype": "string",
        "hide": "${ ('none' if label else 'part') }"
      },
      {
        "id": "type",
        "label": "Type",
        "dtype": "enum",
        "default": "int",
        "options": [
          "real",
          "int",
          "string",
          "bool",
          "raw"
        ],
        "option_labels": [
          "Float",
