     ${id}->set_line_width(i, widths[i]);\n        ${id}->set_line_color(i, colors[i]);\n        ${id}->set_line_alpha(i, alphas[i]);\n    }\n}\n_${id}_win = this->${id}->qwidget();\n\n${gui_hint() % win}"
