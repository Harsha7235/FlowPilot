    "id": "uhd_rfnoc_fosphor",
    "label": "RFNoC Fosphor Block",
    "category": "[Core]/UHD/RFNoC/Blocks",
    "templates": {
      "imports": "from gnuradio import uhd",
      "make": "uhd.rfnoc_block_generic(\n    self.rfnoc_graph,\n    uhd.device_addr(\"\"),\n    'Fosphor',\n    ${device_select},\n    ${instance_index})\nself.${id}.set_property('enable_histogram',     True,             typename='bool')\nself.${id}.set_property('enable_waterfall',     ${enable_wf},     typename='bool')\nself.${id}.set_property('enable_noise',         ${enable_noise},  typename='bool')\nself.${id}.set_property('enable_dither',        ${enable_dither}, typename='bool')\nself.${id}.set_property('hist_decimation',      ${hist_decim}     )\nself.${id}.set_property('offset',               ${offset}         )\nself.${id}.set_property('scale',                ${scale}          )\nself.${id}.set_property('trise',                ${trise}          )\nself.${id}.set_property('tdecay',               ${tdecay}         )\nself.${id}.set_property('alpha',                ${alpha}          )\nself.${id}.set_property('epsilon',              ${epsilon}        )\nself.${id}.set_property('wf_predivision_ratio', ${wf_prediv.val}  )\nself.${id}.set_property('wf_mode',              ${wf_mode.val}    )\nself.${id}.set_property('wf_decimation',        ${wf_decim}       )\nself.${id}.set_property('clear_history',        True,             typename='bool')",
      "callbacks": [
        "set_property('enable_waterfall', ${enable_wf}, typename='bool')",
        "set_property('enable_noise', ${enable_noise}, typename='bool')",
        "set_property('enable_dither', ${enable_dither}, typename='bool')",
        "set_property('hist_decimation', ${hist_decim})",
        "set_property('offset', ${offset})",
        "set_property('scale', ${scale})",
        "set_property('trise', ${trise})",
        "set_property('tdecay', ${tdecay})",
        "set_property('alpha', ${alpha})",
        "set_property('epsilon', ${epsilon})",
        "set_property('wf_predivision_ratio', ${wf_prediv.val})",
        "set_property('wf_mode', ${wf_mode.val})",
        "set_property('wf_decimation', ${wf_decim})"
      ]
    },
