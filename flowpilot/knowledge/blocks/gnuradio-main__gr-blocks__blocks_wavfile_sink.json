    "templates": {
      "imports": "from gnuradio import blocks",
      "make": "blocks.wavfile_sink(\n    ${file},\n    ${nchan},\n    ${samp_rate},\n    ${format.val},\n    % if str(format) == 'FORMAT_WAV':\n    ${bits_per_sample1.val},\n    % elif str(format) == 'FORMAT_FLAC':\n    ${bits_per_sample2.val},\n    % elif str(format) == 'FORMAT_OGG':\n    ${bits_per_sample3.val},\n    % elif str(format) == 'FORMAT_RF64':\n    ${bits_per_sample4.val},\n    % endif\n    % if str(format) == 'FORMAT_WAV':\n    ${append}\n    % elif str(format) == 'FORMAT_FLAC':\n    ${False}\n    % elif str(format) == 'FORMAT_OGG':\n    ${False},\n    % elif str(format) == 'FORMAT_RF64':\n    ${append}\n    % endif\n    )",
      "callbacks": [
        "open(${file})"
      ]
    },
    "cpp_templates": {
      "includes": [
        "#include <gnuradio/blocks/wavfile_sink.h>"
      ],
      "declarations": "blocks::wavfile_sink::sptr ${id};",
      "make": "this->${id} = blocks::wavfile_sink::make(\n    ${file},\n    ${nchan},\n    ${samp_rate},\n    ${format.val},\n    % if str(format) == 'FORMAT_WAV':\n    ${bits_per_sample1.val},\n    % elif str(format) == 'FORMAT_FLAC':\n    ${bits_per_sample2.val},\n    % elif str(format) == 'FORMAT_OGG':\n    ${bits_per_sample3.val},\n    % elif str(format) == 'FORMAT_RF64':\n    ${bits_per_sample4.val},\n    % endif\n    % if str(format) == 'FORMAT_WAV':\n    ${append}\n    % elif str(format) == 'FORMAT_FLAC':\n    ${False}\n    % elif str(format) == 'FORMAT_OGG':\n    ${False},\n    % elif str(format) == 'FORMAT_RF64':\n    ${append}\n    % endif\n    );",
      "callbacks": [
        "this->${id}->open(${file})"
      ]
    },
